{
  "name": "rubbish-scheduler",
  "version": "2.1.0",
  "private": true,
  "description": "A small Node app to add the waste data collection details to my calendar. I created this because Bromley Council kept arbitrarily changes the dates without informing the residents.",
  "homepage": "https://github.com/Jonur/rubbish-scheduler#readme",
  "bugs": {
    "url": "https://github.com/Jonur/rubbish-scheduler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonur/rubbish-scheduler.git"
  },
  "license": "UNLICENCED",
  "author": "Dimitris Damilos<d.k.damilos@gmail.com>",
  "scripts": {
    "start:local": "tsx scripts/waste-collection-local.ts",
    "start:local:mock": "MOCK_SCRAPE=1 tsx scripts/waste-collection-local.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=./coverage/junit.xml",
    "test:coverage": "vitest run --coverage",
    "tree": "tree -a -I \"node_modules|.git|.vercel|dist|build|coverage\" -L 5",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "googleapis": "^189.0.0",
    "ical": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/ical": "^0.8.3",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vercel/node": "^30.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "@vercel/node": {
      "undici": "^6.29.1",
      "path-to-regexp": "^6.3.0",
      "ajv": "^8.20.0",
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    }
  }
}
